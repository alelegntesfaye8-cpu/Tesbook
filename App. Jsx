import React, { useState } from 'react';

export default function TesbookApp() {
  const [lang, setLang] = useState('am'); // 'am' for Amharic, 'en' for English
  const [activeTab, setActiveTab] = useState('store'); // store, publish, admin, guide
  const [books, setBooks] = useState([
    { id: 1, title: 'የተፈጥሮ ሚስጥር', author: 'ተስፋዬ አለልኝ', price: '150 ETB', category: 'ተፈጥሮ እና ሕይወት', cover: '🌿' },
    { id: 2, title: 'የነፃነት ጎህ ሲቀድ', author: 'ተስፋዬ አለልኝ', price: '200 ETB', category: 'ፍልስፍና', cover: '🌅' },
  ]);

  // Form states for publishing
  const [newTitle, setNewTitle] = useState('');
  const [newPrice, setNewPrice] = useState('');
  const [newCategory, setNewCategory] = useState('');

  // AI Assistant State
  const [aiPrompt, setAiPrompt] = useState('');
  const [aiResponse, setAiResponse] = useState('');

  // Admin Payment Settings
  const [cbeAccount, setCbeAccount] = useState('1000123456789 (ተስፋዬ አለልኝ)');
  const [telebirrAccount, setTelebirrAccount] = useState('0911234567 (ተስፋዬ አለልኝ)');

  const handlePublish = (e) => {
    e.preventDefault();
    if (!newTitle || !newPrice) return;
    const book = {
      id: books.length + 1,
      title: newTitle,
      author: 'ተስፋዬ አለልኝ (Tes)',
      price: newPrice,
      category: newCategory || 'አጠቃላይ',
      cover: '📖'
    };
    setBooks([book, ...books]);
    setNewTitle('');
    setNewPrice('');
    setNewCategory('');
    alert(lang === 'am' ? 'መጽሐፉ በተሳካ ሁኔታ ታትሟል!' : 'Book published successfully!');
    setActiveTab('store');
  };

  const askAi = () => {
    if (!aiPrompt) return;
    setAiResponse(
      lang === 'am'
        ? `የ Gemini AI ረዳት መልስ ለ "${aiPrompt}": ይህ መጽሐፍ አንባቢዎችን በከፍተኛ ሁኔታ የሚስብ፣ ግልጽና ማራኪ ቋንቋ የተጻፈ እንዲሆን ማድረግ ይቻላል። ለቲክቶክ እና ቴሌግራም የሚሆን አጭር ማስታወቂያ፡ "የሕይወትህን ከፍታ ለመድረስ ይህንን መጽሐፍ አንብብ!"`
        : `Gemini AI Assistant response for "${aiPrompt}": This book concept has great potential for readers. Recommended TikTok caption: "Discover the new world of knowledge with Tesbook!"`
    );
  };

  return (
    <div className="min-h-screen bg-gray-50 text-gray-900 font-sans">
      {/* Header */}
      <header className="bg-emerald-700 text-white shadow-md sticky top-0 z-50">
        <div className="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
          <div className="flex items-center space-x-2">
            <span className="text-2xl font-bold tracking-wider">📚 Tesbook.com</span>
          </div>
          <div className="flex items-center space-x-4">
            <button 
              onClick={() => setLang(lang === 'am' ? 'en' : 'am')}
              className="bg-emerald-800 px-3 py-1 rounded text-sm font-semibold border border-emerald-600"
            >
              {lang === 'am' ? 'English 🌐' : 'አማርኛ 🌐'}
            </button>
          </div>
        </div>
        {/* Navigation Tabs */}
        <nav className="bg-emerald-800 px-4 flex space-x-4 overflow-x-auto text-sm">
          <button 
            onClick={() => setActiveTab('store')}
            className={`py-2 px-3 border-b-2 font-medium ${activeTab === 'store' ? 'border-white text-white' : 'border-transparent text-emerald-200'}`}
          >
            {lang === 'am' ? '🏠 መደብር (Store)' : '🏠 Store'}
          </button>
          <button 
            onClick={() => setActiveTab('publish')}
            className={`py-2 px-3 border-b-2 font-medium ${activeTab === 'publish' ? 'border-white text-white' : 'border-transparent text-emerald-200'}`}
          >
            {lang === 'am' ? '✍️ መጽሐፍ ጫን (Publish)' : '✍️ Publish'}
          </button>
          <button 
            onClick={() => setActiveTab('ai')}
            className={`py-2 px-3 border-b-2 font-medium ${activeTab === 'ai' ? 'border-white text-white' : 'border-transparent text-emerald-200'}`}
          >
            {lang === 'am' ? '🤖 AI ረዳት (AI Agent)' : '🤖 AI Agent'}
          </button>
          <button 
            onClick={() => setActiveTab('admin')}
            className={`py-2 px-3 border-b-2 font-medium ${activeTab === 'admin' ? 'border-white text-white' : 'border-transparent text-emerald-200'}`}
          >
            {lang === 'am' ? '⚙️ የባለቤት ፓነል (Admin)' : '⚙️ Owner Panel'}
          </button>
          <button 
            onClick={() => setActiveTab('guide')}
            className={`py-2 px-3 border-b-2 font-medium ${activeTab === 'guide' ? 'border-white text-white' : 'border-transparent text-emerald-200'}`}
          >
            {lang === 'am' ? '🚀 ሆስቲንግ መመሪያ (Guide)' : '🚀 Guide'}
          </button>
        </nav>
      </header>

      {/* Main Content */}
      <main className="max-w-6xl mx-auto p-4 md:p-6">
        
        {/* STORE TAB */}
        {activeTab === 'store' && (
          <div>
            <div className="bg-gradient-to-r from-emerald-600 to-teal-700 text-white p-6 rounded-2xl mb-8 shadow-lg">
              <h1 className="text-3xl font-bold mb-2">
                {lang === 'am' ? 'በኢትዮጵያ የመጀመሪያው ነፃ የዲጂታል መጽሐፍ መድረክ' : 'Ethiopia\'s Premier Digital E-book Platform'}
              </h1>
              <p className="text-emerald-100">
                {lang === 'am' 
                  ? 'መጽሐፎትን በቀላሉ ይሽጡ፣ ያስተዋውቁ፣ እና በቴሌብር ወይም በባንክ ክፍያ ይቀበሉ።' 
                  : 'Sell, publish, and promote your e-books easily with local Ethiopian payment methods.'}
              </p>
            </div>

            <h2 className="text-xl font-bold mb-4 text-gray-800">
              {lang === 'am' ? '📖 የተመረጡ መጻሕፍት' : '📖 Featured Books'}
            </h2>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              {books.map((b) => (
                <div key={b.id} className="bg-white p-5 rounded-xl shadow border border-gray-100 flex flex-col justify-between">
                  <div>
                    <div className="text-4xl mb-3 bg-emerald-50 w-16 h-16 flex items-center justify-center rounded-lg">{b.cover}</div>
                    <span className="text-xs bg-emerald-100 text-emerald-800 px-2 py-1 rounded font-semibold">{b.category}</span>
                    <h3 className="font-bold text-lg mt-2">{b.title}</h3>
                    <p className="text-gray-600 text-sm">ደራሲ: {b.author}</p>
                  </div>
                  <div className="mt-4 pt-4 border-t flex justify-between items-center">
                    <span className="font-bold text-emerald-700 text-lg">{b.price}</span>
                    <button 
                      onClick={() => alert(lang === 'am' ? `ክፍያ ለመፈጸም ወደ ቴሌብር (${telebirrAccount}) ወይም ሲቢኢ (${cbeAccount}) ያስተላልፉ።` : `Please send payment to Telebirr (${telebirrAccount})`)}
                      className="bg-emerald-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-emerald-700 transition"
                    >
                      {lang === 'am' ? 'ግዛ (Buy)' : 'Buy Now'}
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* PUBLISH TAB */}
        {activeTab === 'publish' && (
          <div className="bg-white max-w-xl mx-auto p-6 rounded-2xl shadow border border-gray-100">
            <h2 className="text-2xl font-bold mb-4 text-emerald-800">
              {lang === 'am' ? '✍️ አዲስ መጽሐፍ ማሳተሚያ' : '✍️ Publish New E-Book'}
            </h2>
            <form onSubmit={handlePublish} className="space-y-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">{lang === 'am' ? 'የመጽሐፉ ርዕስ (Title)' : 'Book Title'}</label>
                <input 
                  type="text" 
                  value={newTitle} 
                  onChange={(e) => setNewTitle(e.target.value)} 
                  className="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-emerald-500 outline-none"
                  placeholder="ምሳሌ፦ የሕይወት ጎዳና"
                  required
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">{lang === 'am' ? 'ዋጋ (Price in ETB)' : 'Price'}</label>
                <input 
                  type="text" 
                  value={newPrice} 
                  onChange={(e) => setNewPrice(e.target.value)} 
                  className="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-emerald-500 outline-none"
                  placeholder="ምሳሌ፦ 150 ETB"
                  required
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">{lang === 'am' ? 'ዘርፍ (Category)' : 'Category'}</label>
                <input 
                  type="text" 
                  value={newCategory} 
                  onChange={(e) => setNewCategory(e.target.value)} 
                  className="w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-emerald-500 outline-none"
                  placeholder="ምሳሌ፦ ልብ ወለድ፣ ቴክኖሎጂ"
                />
              </div>
              <button type="submit" className="w-full bg-emerald-600 text-white py-3 rounded-lg font-bold hover:bg-emerald-700 transition">
                {lang === 'am' ? 'መጽሐፉን ለቀቅ (Publish Now)' : 'Publish Book'}
              </button>
            </form>
          </div>
        )}

        {/* AI AGENT TAB */}
        {activeTab === 'ai' && (
          <div className="bg-white max-w-xl mx-auto p-6 rounded-2xl shadow border border-gray-100">
            <h2 className="text-2xl font-bold mb-2 text-emerald-800">
              {lang === 'am' ? '🤖 Gemini AI ደራሲና ማስታወቂያ ረዳት' : '🤖 Gemini AI Writer Assistant'}
            </h2>
            <p className="text-gray-600 text-sm mb-4">
              {lang === 'am' ? 'ለማስታወቂያ የሚሆን ጽሁፍ ወይም የመጽሐፍ ሐሳብ ከፈለጉ እዚህ ይጠይቁ።' : 'Ask AI for marketing quotes, book ideas, or summaries.'}
            </p>
            <textarea 
              value={aiPrompt}
              onChange={(e) => setAiPrompt(e.target.value)}
              className="w-full border rounded-lg p-3 h-28 focus:ring-2 focus:ring-emerald-500 outline-none mb-3"
              placeholder={lang === 'am' ? 'ለምሳሌ፦ ስለ ተፈጥሮ ጥበቃ የሚሆን አጭር የቲክቶክ ማስታወቂያ ጽሁፍ ጻፍልኝ' : 'Type your prompt here...'}
            />
            <button onClick={askAi} className="w-full bg-teal-600 text-white py-2.5 rounded-lg font-bold hover:bg-teal-700 transition mb-4">
              {lang === 'am' ? 'AI መልስ ፍጠር (Generate)' : 'Generate with AI'}
            </button>
            {aiResponse && (
              <div className="bg-emerald-50 border border-emerald-200 p-4 rounded-lg text-emerald-900">
                <h4 className="font-bold mb-1">የ AI ምላሽ (AI Response):</h4>
                <p>{aiResponse}</p>
              </div>
            )}
          </div>
        )}

        {/* ADMIN TAB */}
        {activeTab === 'admin' && (
          <div className="bg-white max-w-xl mx-auto p-6 rounded-2xl shadow border border-gray-100">
            <h2 className="text-2xl font-bold mb-2 text-emerald-800">
              {lang === 'am' ? '⚙️ የባለቤት መቆጣጠሪያ ፓነል (Admin Panel)' : '⚙️ Owner Control Panel'}
            </h2>
            <p className="text-gray-600 text-sm mb-4">
              {lang === 'am' ? 'የባንክ እና የቴሌብር አካውንትዎን ያስገቡ፤ ገቢው በቀጥታ ወደ እርስዎ ይገባል።' : 'Update your payment details below.'}
            </p>
            <div className="space-y-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">የንግድ ባንክ (CBE Account)</label>
                <input 
                  type="text" 
                  value={cbeAccount} 
                  onChange={(e) => setCbeAccount(e.target.value)} 
                  className="w-full border rounded-lg p-2.5"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">ቴሌብር (Telebirr Account)</label>
                <input 
                  type="text" 
                  value={telebirrAccount} 
                  onChange={(e) => setTelebirrAccount(e.target.value)} 
                  className="w-full border rounded-lg p-2.5"
                />
              </div>
              <div className="bg-green-50 p-3 rounded text-green-800 text-sm">
                ✅ <b>ተዘምኗል!</b> ሁሉም ተጠቃሚዎች የሚከፍሉበት ገንዘብ አሁን ወደ እርስዎ አካውንት እንዲገባ ተደርጓል።
              </div>
            </div>
          </div>
        )}

        {/* GUIDE TAB */}
        {activeTab === 'guide' && (
          <div className="bg-white max-w-2xl mx-auto p-6 rounded-2xl shadow border border-gray-100 space-y-4">
            <h2 className="text-2xl font-bold text-emerald-800">
              {lang === 'am' ? '🚀 ዌብሳይቱን በነፃ የመጫኛ መመሪያ (Hosting Guide)' : '🚀 Free Hosting Guide'}
            </h2>
            <ol className="list-decimal list-inside space-y-3 text-gray-700">
              <li><b>GitHub Repository:</b> አሁን በፈጠሩት `tesbook` ሪፖዚቶሪ ውስጥ ይህንን ኮድ **`App.jsx`** በሚል ስም ሎድ (Upload) ያድርጉት።</li>
              <li><b>Vercel / Netlify:</b> በ <a href="https://vercel.com" target="_blank" rel="noreferrer" className="text-emerald-600 underline">vercel.com</a> ላይ በ GitHub አካውንትዎ በመግባት (Login) ሪፖዚቶሪዎን ይምረጡ።</li>
              <li><b>Deploy:</b> "Deploy" የሚለውን ቁልፍ ሲጫኑ ዌብሳይትዎ በ 1 ደቂቃ ውስጥ በነፃ ሊንክ ይሰራል።</li>
              <li><b>Domain Name:</b> <b>tesbook.com</b> የሚለውን ዶሜይን በራስዎ ስም ከ Namecheap ወይም Ethio Telecom ገዝተው ከ Vercel ጋር ማገናኘት ይችላሉ።</li>
            </ol>
          </div>
        )}

      </main>

      {/* Footer */}
      <footer className="bg-gray-800 text-gray-400 text-center py-6 mt-12 text-sm">
        <p>© 2026 Tesbook.com — All rights reserved. Created by Tesfaye Alelegn (ተስፋዬ አለልኝ).</p>
      </footer>
    </div>
  );
}
